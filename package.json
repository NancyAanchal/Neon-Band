{
  "name": "neon-band",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A neon band simulator: guitar, bass, piano, drums and violin, synthesized in the browser.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --mode single",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "5.4.5",
    "vite": "5.4.10",
    "vite-plugin-singlefile": "2.0.2"
  }
}
